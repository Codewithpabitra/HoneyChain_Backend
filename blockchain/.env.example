# Polygon Amoy RPC URL (e.g., Infura, Alchemy, or public RPC)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Deployer / Admin Private Key (Dedicated Testnet wallet only, with POL gas tokens)
